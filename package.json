{
  "name": "vamps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gallery": "vite --open /gallery.html",
    "materials": "vite --open /materials.html",
    "blocks": "vite --open /blocks.html",
    "scene": "vite --open /scene.html",
    "shot": "node scripts/shot.mjs",
    "draft": "node scripts/blocks/draft.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:quick": "playwright test menu geoscape events inventory",
    "batch": "node scripts/batch.mjs",
    "format": "prettier --write src e2e scripts \"*.ts\"",
    "format:check": "prettier --check src e2e scripts \"*.ts\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  }
}
